# Supabase — https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # NEVER commit real value

# Supabase — browser/client-side (safe to expose, prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM=deals@mail.yourdomain.com
RESEND_WEBHOOK_SECRET=whsec_...   # from Resend dashboard → Webhooks → signing secret (Phase 2)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kiwi Tequila — https://tequila.kiwi.com
KIWI_API_KEY=your-kiwi-api-key

# Monitoring (Phase 5 / v2)
HEALTHCHECKS_PING_URL=https://hc-ping.com/...

# Emergency kill switch — set to "true" to skip sending
PIPELINE_KILL_SWITCH=false
